$array = [
    10,
    20,
    [30, 40],
    [50, [60]]
];

function recursiveSum($array)
{
    $sum = 0;

    foreach ($array as $value) {

        if (is_array($value)) {
            $sum += recursiveSum($value);
        } else {
            $sum += $value;
        }

    }

    return $sum;
}

echo recursiveSum($array);

?>
<?php

$array = [1, [2, 3], [4, [5, 6]]];

$result = [];

function flatten($array, &$result)
{
    foreach ($array as $item) {

        if (is_array($item)) {
            flatten($item, $result);
        } else {
            $result[] = $item;
        }

    }
}

flatten($array, $result);

print_r($result);


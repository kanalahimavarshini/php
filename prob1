$stmt->bindValue(
    ":limit",
    $limit,
    PDO::PARAM_INT
);

$stmt->bindValue(
    ":offset",
    $offset,
    PDO::PARAM_INT
);

$stmt->execute();

$students = $stmt->fetchAll(
    PDO::FETCH_ASSOC
);

foreach ($students as $student) {
    echo $student["name"] . "<br>";
}


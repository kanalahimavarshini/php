function rotateArray(array &$nums, int $k): void
{
    $n = count($nums);

    if ($n === 0) {
        return;
    }

    $k %= $n;

    $nums = array_merge(
        array_slice($nums, $n - $k),
        array_slice($nums, 0, $n - $k)
    );
}

$nums = [1, 2, 3, 4, 5, 6, 7];

rotateArray($nums, 3);

print_r($nums);


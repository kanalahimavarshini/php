function hasCycle(?Node $head): bool
{
    $slow = $head;
    $fast = $head;

    while (
        $fast !== null &&
        $fast->next !== null
    ) {

        $slow = $slow->next;
        $fast = $fast->next->next;

        if ($slow === $fast) {
            return true;
        }
    }

    return false;
}

$head = new Node(1);
$head->next = new Node(2);
$head->next->next = new Node(3);

$head->next->next->next = $head;

var_dump(hasCycle($head));


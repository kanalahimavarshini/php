function solveNQueens(int $n): array
{
    $board = array_fill(
        0,
        $n,
        str_repeat(".", $n)
    );

    $result = [];

    function backtrack(
        int $row,
        int $n,
        array &$board,
        array &$result
    ): void {

        if ($row === $n) {
            $result[] = $board;
            return;
        }

        for ($col = 0; $col < $n; $col++) {

            $valid = true;

            for ($r = 0; $r < $row; $r++) {

                $queenCol = strpos(
                    $board[$r],
                    "Q"
                );

                if (
                    $queenCol === $col ||
                    abs($queenCol - $col) ===
                    abs($r - $row)
                ) {
                    $valid = false;
                    break;
                }
            }

            if (!$valid) {
                continue;
            }

            $rowString = $board[$row];

            $rowString[$col] = "Q";

            $board[$row] = $rowString;

            backtrack(
                $row + 1,
                $n,
                $board,
                $result
            );

            $board[$row] = str_repeat(".", $n);
        }
    }

    backtrack(
        0,
        $n,
        $board,
        $result
    );

    return $result;
}


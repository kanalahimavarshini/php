function climbStairs(int $n): int
{
    if ($n <= 2) {
        return $n;
    }

    $a = 1;
    $b = 2;

    for ($i = 3; $i <= $n; $i++) {

        $next = $a + $b;

        $a = $b;
        $b = $next;
    }

    return $b;
}


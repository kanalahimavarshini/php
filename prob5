function lengthOfLIS(array $nums): int
{
    $dp = array_fill(
        0,
        count($nums),
        1
    );

    $answer = 0;

    for ($i = 0; $i < count($nums); $i++) {

        for ($j = 0; $j < $i; $j++) {

            if ($nums[$j] < $nums[$i]) {

                $dp[$i] = max(
                    $dp[$i],
                    $dp[$j] + 1
                );
            }
        }

        $answer = max($answer, $dp[$i]);
    }

    return $answer;
}


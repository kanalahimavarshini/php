function maxProfit(array $prices): int
{
    $minPrice = PHP_INT_MAX;
    $maxProfit = 0;

    foreach ($prices as $price) {

        $minPrice = min(
            $minPrice,
            $price
        );

        $maxProfit = max(
            $maxProfit,
            $price - $minPrice
        );
    }

    return $maxProfit;
}


function lcs(string $a, string $b): int
{
    $m = strlen($a);
    $n = strlen($b);

    $dp = array_fill(
        0,
        $m + 1,
        array_fill(0, $n + 1, 0)
    );

    for ($i = 1; $i <= $m; $i++) {

        for ($j = 1; $j <= $n; $j++) {

            if ($a[$i - 1] === $b[$j - 1]) {

                $dp[$i][$j] =
                    $dp[$i - 1][$j - 1] + 1;

            } else {

                $dp[$i][$j] = max(
                    $dp[$i - 1][$j],
                    $dp[$i][$j - 1]
                );
            }
        }
    }

    return $dp[$m][$n];
}


function maxSubArray(array $nums): int
{
    $current = $nums[0];
    $maximum = $nums[0];

    for ($i = 1; $i < count($nums); $i++) {

        $current = max(
            $nums[$i],
            $current + $nums[$i]
        );

        $maximum = max(
            $maximum,
            $current
        );
    }

    return $maximum;
}


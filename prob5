function coinChange(array $coins, int $amount): int
{
    $dp = array_fill(
        0,
        $amount + 1,
        $amount + 1
    );

    $dp[0] = 0;

    for ($i = 1; $i <= $amount; $i++) {

        foreach ($coins as $coin) {

            if ($coin <= $i) {

                $dp[$i] = min(
                    $dp[$i],
                    $dp[$i - $coin] + 1
                );
            }
        }
    }

    return $dp[$amount] > $amount
        ? -1
        : $dp[$amount];
}

